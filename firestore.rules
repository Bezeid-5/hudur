rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'employee';
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /attendances/{id} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.checkIn == request.time
        && request.resource.data.checkOut == null;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.checkOut == null
        && request.resource.data.checkOut == request.time
        && request.resource.data.checkIn == resource.data.checkIn
        && request.resource.data.userId == resource.data.userId;
      allow delete: if false;
    }

    match /activities/{id} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['userId', 'attendanceId', 'title', 'durationMinutes', 'description', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['userId', 'attendanceId', 'title', 'durationMinutes', 'createdAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes > 0
        && request.resource.data.durationMinutes <= 1440
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 500))
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/attendances/$(request.resource.data.attendanceId)).data.userId == request.auth.uid;

      allow update, delete: if false;
    }
  }
}

